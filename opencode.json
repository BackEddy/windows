{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git tag*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git -C*": "deny",
      "git -c*": "deny",
      "gh *": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "rm -r*": "deny",
      "rm -f*": "deny",
      "bash -c*": "deny",
      "sh -c*": "deny",
      "zsh -c*": "deny"
    }
  }
}
